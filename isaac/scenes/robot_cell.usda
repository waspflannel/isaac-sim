#usda 1.0
(
    defaultPrim = "Cell"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Cell"
{
    def Xform "Robot" (
        prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.1/Isaac/Robots_Multiphysics/UniversalRobots/ur10/ur10.usda@
        variants = { string Gripper = "short_suction" }
    )
    {
        double3 xformOp:translate = (0, 0, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "Workbench" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.075, 0.11, 0.14)]
        double3 xformOp:translate = (0.25, 0.1, 0.4)
        double3 xformOp:scale = (1.6, 1.4, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Xform "Input"
    {
        double3 xformOp:translate = (0.45, 0, 0.84)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Process"
    {
        double3 xformOp:translate = (0.45, 0.35, 0.84)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Xform "Output"
    {
        double3 xformOp:translate = (0.45, -0.35, 0.84)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
