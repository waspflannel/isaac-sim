        def Mesh "Label" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            rel material:binding = </World/KitMachine/LabelMaterial>
            point3f[] points = [(-0.75, -0.12, 1.92), (0.75, -0.12, 1.92), (0.75, -0.12, 2.24), (-0.75, -0.12, 2.24)]
            texCoord2f[] primvars:st = [(0, 0), (1, 0), (1, 1), (0, 1)] (
                interpolation = "vertex"
            )
            uniform token subdivisionScheme = "none"
        }

        def Material "LabelMaterial" (
            apiSchemas = None
        )
        {
            token outputs:surface.connect = </World/KitMachine/LabelMaterial/Surface.outputs:surface>

            def Shader "Surface" (
                apiSchemas = ["NodeDefAPI"]
            )
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/KitMachine/LabelMaterial/Texture.outputs:rgb>
                token outputs:surface
            }

            def Shader "Texture" (
                apiSchemas = ["NodeDefAPI"]
            )
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @labels/Kit.png@
                float2 inputs:st.connect = </World/KitMachine/LabelMaterial/UV.outputs:result>
                color3f outputs:rgb
            }

            def Shader "UV" (
                apiSchemas = ["NodeDefAPI"]
            )
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }

