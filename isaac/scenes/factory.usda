#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    apiSchemas = None
)
{
    def Cube "Floor" (
        apiSchemas = None
    )
    {
        color3f[] primvars:displayColor = [(0.12, 0.15, 0.18)]
        double size = 1
        float3 xformOp:scale = (16, 10, 0.2)
        double3 xformOp:translate = (0, 1, -0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def DomeLight "Light" (
        apiSchemas = ["LightAPI", "CollectionAPI:lightLink", "CollectionAPI:shadowLink"]
    )
    {
        float inputs:intensity = 900
    }

